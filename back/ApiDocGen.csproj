<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- Git cloning -->
		<PackageReference Include="LibGit2Sharp" Version="0.30.*" />

		<!-- Roslyn syntax tree parsing — pinned to 4.8.x to match EF Core Design transitive deps -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.*" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />

		<!-- Database (PostgreSQL via EF Core) -->
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.*">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<!-- JWT Authentication -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.*" />

		<!-- GitHub API client -->
		<PackageReference Include="Octokit" Version="13.*" />
	</ItemGroup>

</Project>
